 @model Reservation.Models.ViewModels.RestaurantListModel
@{
    ViewData["Title"] = "餐廳列表";
}

<!-- 頂部漸層導航欄 -->
<header class="restaurant-header">
    <div class="header-content">
        <h1 class="header-title">@(Model.SelectedBranchId.HasValue ? 
            Model.Branches.FirstOrDefault(b => b.Id == Model.SelectedBranchId)?.Name ?? "遠百信義A13" 
            : "遠百信義A13")</h1>
    </div>
</header>
<!-- 搜尋與篩選區域 -->
<div class="search-filter-section">
    <div class="container-fluid px-3 py-3">
        <!-- 分店選擇 -->
        <div class="row mb-3">
            <div class="col-md-4 col-6 mb-2">
                <div class="dropdown">
                    <button class="btn btn-primary dropdown-toggle w-100 text-start unified-control" type="button" 
                            id="branchDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <span id="selectedBranchText">@(Model.SelectedBranchId.HasValue ? Model.Branches.FirstOrDefault(b => b.Id == Model.SelectedBranchId)?.Name ?? "分店選擇" : "分店選擇")</span>
                        <span class="dropdown-arrow-wrapper">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                            </svg>
                        </span>
                    </button>
                    <ul class="dropdown-menu w-100" aria-labelledby="branchDropdown">
                        <li>
                            <a class="dropdown-item" 
                               href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId })"
                               onclick="sessionStorage.setItem('gpsLocationAsked', 'no'); sessionStorage.setItem('userSelectedAllBranches', 'true');">
                                所有分店
                            </a>
                        </li>
                        @foreach (var branch in Model.Branches)
                        {
                            var branchGroupId = Model.GroupIdToBranchId.FirstOrDefault(x => x.Value == branch.Id).Key ?? "";
                            <li>
                                <a class="dropdown-item @(Model.SelectedBranchId == branch.Id ? "active" : "")" 
                                   href="@Url.Action("Index", new { groupId = branchGroupId, categoryId = Model.SelectedCategoryId })">
                                    @branch.Name
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div class="col-md-8 col-6 mb-2">
                <a href="@Url.Action("QueryRecord", "Restaurant")" 
                   class="w-100 unified-control d-flex align-items-center justify-content-center text-secondary text-decoration-none" 
                   style="border: none; padding: 0.5rem 0;">
                    <img src="@Url.Content("~/Image/icon.png")" alt="訂候位紀錄查詢" class="me-2" style="width: 20px; height: 20px;">
                    <span style="border-bottom: 1px solid #6c757d;">訂候位紀錄查詢</span>
                </a>
            </div>
        </div>

        <!-- 類別篩選 -->
        <div class="category-filter">
            @foreach (var category in Model.Categories)
            {
                var isActive = (Model.SelectedCategoryId == category.Id) || 
                              (!Model.SelectedCategoryId.HasValue && category.Id == 0);
                <a href="@Url.Action("Index", new { groupId = Model.SelectedGroupId, categoryId = category.Id == 0 ? (int?)null : category.Id })" 
                   class="category-tag @(isActive ? "active" : "")">
                    @category.Name
                </a>
                @if (category != Model.Categories.Last())
                {
                    <span class="category-separator">|</span>
                }
            }
        </div>
    </div>
</div>

<!-- 餐廳列表 -->
<div class="restaurant-list-section">
    <div class="container-fluid px-3">
        @if (Model.RestaurantCards != null && Model.RestaurantCards.Any())
        {
            @foreach (var card in Model.RestaurantCards)
            {
                <div class="restaurant-card">
                    <div class="row g-0">
                        <!-- 左側圖片 - 直接使用本地目錄圖片 -->
                        <div class="col-md-3 col-4">
                            <div class="restaurant-image-wrapper">
                                <img src="@Url.Content($"~/IMG/HomePage/{card.GroupId}/{card.id}.jpg")" 
                                     class="restaurant-image" 
                                     alt="@card.Name"
                                     onerror="this.src='@Url.Content("~/IMG/HomePage/10.jpg")'" />
                            </div>
                        </div>
                        <!-- 右側資訊 -->
                        <div class="col-md-9 col-8">
                            <div class="restaurant-info">
                                <h3 class="restaurant-name">@card.Name</h3>
                                <div class="restaurant-details">
                                    <div class="detail-item">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#258cfb" viewBox="0 0 16 16" class="detail-icon">
                                            <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
                                        </svg>
                                        <span>@card.Address</span>
                                    </div>
                                    <div class="detail-item">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#258cfb" viewBox="0 0 16 16" class="detail-icon">
                                            <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.568 17.568 0 0 0 4.168 6.608 17.569 17.569 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122L9.78 10.22a.678.678 0 0 1-.58-.122L6.5 7.5a.678.678 0 0 1-.122-.58l.122-1.034a.678.678 0 0 0-.122-.58L3.654 1.328z"/>
                                        </svg>
                                        <span>@card.PhoneNumber</span>
                                    </div>
                                </div>
                                <div class="restaurant-actions">
                                    @if (card.WebBookingEnabled)
                                    {
                                        <a href="@Url.Action("Index", "Reservation", new { branchId = card.GroupId, restaurantId = card.id })" 
                                           class="btn btn-outline-primary btn-reservation">訂位</a>
                                    }
                                    @if (card.WebWaitingEnabled)
                                    {
                                        <a href="@Url.Action("Index", "WaitingPosition", new { branchId = card.GroupId, restaurantId = card.id })" 
                                           class="btn btn-outline-secondary btn-queue">候位</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted">目前沒有符合條件的餐廳</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // 圖片錯誤處理（舊版邏輯）
        function imgError(e) {
            const image = e.target;
            image.removeEventListener('error', imgError);
            image.src = "@Url.Content("~/IMG/HomePage/10.jpg")";
        }

        document.querySelectorAll('img.restaurant-image').forEach(img => {
            if (img.naturalWidth === 0) {
                img.addEventListener('error', imgError);
                img.src = img.src;
            }
        });

        // GPS 地理位置偵測
        $(document).ready(function(){
            @if(string.IsNullOrWhiteSpace(Model.SelectedGroupId))
            {
                <text>
                    // 檢查用戶是否主動選擇了「所有分店」
                    var userSelectedAllBranches = sessionStorage.getItem('userSelectedAllBranches');
                    
                    // 如果用戶主動選擇了「所有分店」，不執行 GPS 定位
                    if(userSelectedAllBranches === 'true'){
                        // 清除標記，但保留 gpsLocationAsked 為 'no'，避免下次再詢問
                        sessionStorage.removeItem('userSelectedAllBranches');
                        // 不執行任何 GPS 定位相關操作
                    } else {
                        // 移除 HTTPS 限制，支援 HTTP 和 HTTPS
                        if(navigator.geolocation){
                            // 檢查是否已經詢問過用戶（在同一個瀏覽器會話中）
                            var gpsAsked = sessionStorage.getItem('gpsLocationAsked');
                            
                            if(!gpsAsked){
                                // 第一次訪問，詢問用戶
                                setTimeout(function(){
                                    if(confirm('是否要根據您的位置自動選擇分館？')){
                                        // 用戶同意，記錄並執行 GPS 定位
                                        sessionStorage.setItem('gpsLocationAsked', 'yes');
                                        detectLocationByGPS();
                                    } else {
                                        // 用戶拒絕，記錄但不執行
                                        sessionStorage.setItem('gpsLocationAsked', 'no');
                                    }
                                }, 500);
                            } else if(gpsAsked === 'yes'){
                                // 用戶之前同意過，直接執行 GPS 定位（不再次詢問）
                                setTimeout(function(){
                                    detectLocationByGPS();
                                }, 500);
                            }                      
                        }
                    }
                </text>
            }
            
            function detectLocationByGPS(){
                console.log('開始 GPS 定位...');
                
                if(!navigator.geolocation){
                    console.error('瀏覽器不支援 GPS 定位功能');
                    alert('您的瀏覽器不支援 GPS 定位功能');
                    return;
                }

                navigator.geolocation.getCurrentPosition(
                    function(position){
                        var lat = position.coords.latitude;
                        var lng = position.coords.longitude;
                        var accuracy = position.coords.accuracy;
                        console.log('GPS 座標取得成功：', {
                            lat: lat,
                            lng: lng,
                            accuracy: accuracy + ' 公尺'
                        });

                        console.log('發送 AJAX 請求到：', '@Url.Action("GetMallByGPS", "Restaurant")');
                        $.ajax({
                            url:'@Url.Action("GetMallByGPS", "Restaurant")',
                            type:'GET',
                            data:{lat:lat,lng:lng},
                            success:function(response){
                                console.log('GPS API 回應成功：', response);
                                
                                if(response.success && response.groupId){
                                    // 跳轉到對應的分館頁面
                                    var url = '@Url.Action("Index","Restaurant")' + '?groupId=' + response.groupId;
                                    console.log('準備跳轉到：', url);
                                    window.location.href = url;
                                }else{
                                    // 顯示具體錯誤訊息
                                    var errorMsg = response.message || '無法判斷最近的分館';
                                    console.warn('無法判斷最近的分館，回應訊息：', errorMsg);
                                    console.log('完整回應：', response);
                                }
                            },
                            error:function(xhr, status, error){
                                console.error('GPS API 請求失敗：', {
                                    status: xhr.status,
                                    statusText: xhr.statusText,
                                    responseText: xhr.responseText,
                                    error: error,
                                    statusCode: status
                                });
                            }
                        });
                    },
                    function(error){
                        // 改進錯誤處理，顯示具體錯誤原因和錯誤代碼
                        var errorMessage = 'GPS 定位失敗';
                        var errorCode = error && error.code !== undefined ? error.code : -1;
                        
                        // 根據錯誤代碼設定錯誤訊息
                        switch(errorCode){
                            case 1: // PERMISSION_DENIED
                                errorMessage = 'GPS 定位權限被拒絕';
                                break;
                            case 2: // POSITION_UNAVAILABLE
                                errorMessage = 'GPS 位置資訊不可用';
                                break;
                            case 3: // TIMEOUT
                                errorMessage = 'GPS 定位請求超時';
                                break;
                            default:
                                // 嘗試從 error 物件取得更多資訊
                                if(error && error.message){
                                    errorMessage = 'GPS 定位失敗：' + error.message;
                                } else {
                                    errorMessage = 'GPS 定位失敗：未知錯誤';
                                }
                                break;
                        }
                        
                        // 改進 console 輸出格式，使其更易讀
                        console.error('GPS 定位錯誤');
                        console.error('錯誤代碼：', errorCode);
                        console.error('錯誤訊息：', errorMessage);
                        if(error){
                            console.error('錯誤物件：', error);
                        }
                    },
                    {
                        timeout: 10000,
                        enableHighAccuracy: false,
                        maximumAge: 300000
                    }
                );
            }  // 結束 detectLocationByGPS 函數
        });    // 結束 $(document).ready
    </script>
}


