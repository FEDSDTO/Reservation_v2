<script type="text/javascript">

        function WinOnResize() { // 以 function 的方式來寫

            if (document.body.clientWidth < 768) // 當瀏覽器寬度 > 500px 例如 Full-HD
            {
                //document.getElementById("header").style.backgroundImage = "url('../../IMG/big_mb_banner.png') center center no-repeat";
            }
            else {
                //document.getElementById("header").style.background = "url('../../IMG/big_banner.png') center center no-repeat";
            }

        }
        window.onresize = WinOnResize
        window.onload = WinOnResize


        $(document).ready(function () {

            $('[data-ordermeal]').fancybox({
                toolbar: false,
                smallBtn: true,
                clickSlide: 'false',
                touch: {
                    vertical: true,  // 允許垂直方向拖拽
                    momentum: true   // Continue movement after releasing mouse/touch when panning
                },
                iframe: {
                    preload: false,
                    css: {
                        //width: "25%",
                        //height:"60%",
                    },
                    slideShow:
                    {
                        autoStart: false,
                        speed: 4000,
                    },
                    clickOutside: 'close',
                },
            });

            $('[data-checkout]').fancybox({
                toolbar: false,
                smallBtn: true,
                clickSlide: 'false',
